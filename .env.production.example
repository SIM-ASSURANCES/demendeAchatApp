# Variables du docker-compose.prod.yml — à renseigner dans Dokploy (onglet Environment du projet)
# ou dans un fichier .env.production local (gitignored, jamais commité). Ne jamais mettre de
# valeurs réelles dans ce fichier .example, qui reste versionné.

# Base de données
POSTGRES_PASSWORD=

# Secrets applicatifs — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
VERIFICATION_SECRET=

# SMTP (notifications email F-09) — laisser vide en environnement de recette : les emails sont
# alors journalisés en console côté backend au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Compte administrateur initial (créé au premier démarrage du conteneur backend, jamais réécrit
# ensuite — upsert idempotent)
SUPER_ADMIN_NOM="Zah Bi Gohore Arnaud"
SUPER_ADMIN_IDENTIFIANT=admin
SUPER_ADMIN_EMAIL=simassurances2025@gmail.com
SUPER_ADMIN_PASSWORD=
